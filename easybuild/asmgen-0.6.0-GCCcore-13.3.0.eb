#
# asmgen has no release tags and the "asmgen" on PyPI is an unrelated 6502
# assembler, so the source is a pinned commit of the GitHub repository.

easyblock = 'PythonPackage'

name = 'asmgen'
version = '0.6.0'
local_commit = '3ef19a78db2a86aca270d7c02956d130f29ea339'

homepage = 'https://github.com/FZJ-JSC/jukefa-asmgen'
description = """asmgen generates assembly for AVX/FMA, AVX2, AVX-512, Arm NEON,
SVE and SME, and RISC-V RVV from Python, the instruction sets behind ukrgen's
kernels."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

sources = [{
    'filename': '%(name)s-%(version)s.tar.xz',
    'git_config': {
        'url': 'https://github.com/FZJ-JSC',
        'repo_name': 'jukefa-asmgen',
        'commit': local_commit,
    },
}]
checksums = ['be2c0f274eb9e556f742a534c3e48eb25868b1656d64b24e0dcb35a8e55bff90']

builddependencies = [
    ('binutils', '2.42'),
    ('hatchling', '1.24.2'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('Mako', '1.3.5'),
]

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages/asmgen'],
}

sanity_check_commands = [
    "python -c 'import asmgen.asmblocks.sve'",
    "python -c 'import asmgen.asmblocks.rvv'",
]

moduleclass = 'devel'
